POSTGRES_USER=chess
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chess_assistant
POSTGRES_PORT=5433
APP_PORT=5050

# Used by migrate script / local tools (host machine → published Postgres port)
DATABASE_URL=postgresql://chess:change-me@127.0.0.1:5433/chess_assistant

# Flask session signing key — set a long random value in production
SECRET_KEY=change-me-to-a-long-random-string

# Seeded admin account (created on first boot if missing)
SEED_USER_EMAIL=hladii.b.v@gmail.com
SEED_USER_PASSWORD=chess123

# Set to 1 behind HTTPS
SESSION_COOKIE_SECURE=0
